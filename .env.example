# ============ TEST TARGET ============
# All testing happens against this store deployment:
BASE_URL=https://automations-store.hyperzod.me/

# Absolute path to the hyperzod-ui-ordering repo (used to auto start the dev server).
# Windows default below - override via env on macOS/Linux, e.g.
# ORDERING_UI_DIR=/home/you/hyperzod-ui-ordering
ORDERING_UI_DIR=C:\Hyperzod_repo\hyperzod-ui-ordering

# Set to "false" to skip auto-starting the dev server (when it is already running)
AUTO_START_SERVER=true

# ---- Test user (created by signup flow, deleted at the end of the run) ----
TEST_USER_FIRST_NAME=Playwright Tester
TEST_USER_EMAIL=jksdgjsdjgsdjgh@gmail.com
TEST_USER_PHONE=8224231415
TEST_USER_COUNTRY=India
TEST_USER_PASSWORD=Test@123456

# Location typed into the welcome-page search box; the first suggestion is picked.
# MUST be inside the target store's service area (change per target URL).
TEST_LOCATION_QUERY=Indore

# Fallback OTP if the API does not echo the OTP code back (dev backends normally do)
TEST_FALLBACK_OTP=1234

# ---- Suite policy (do not change without review) ----
# Payments: COD/Cash only. Gateway specs are out of scope and must SKIP, not fail.
# Devices: web (Desktop Chrome 1440x900), android (Pixel 7), ios (iPhone 14).
# Run subsets: npm run test:web | test:android | test:ios | test:smoke (--grep @smoke)
