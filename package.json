{
	"name": "hyperzod-ordering-e2e",
	"version": "1.0.0",
	"private": true,
	"description": "Playwright end-to-end tests for the Hyperzod consumer ordering UI (hyperzod-ui-ordering)",
	"scripts": {
		"test": "node scripts/run-suite.js all",
		"test:web": "node scripts/run-suite.js web",
		"test:android": "node scripts/run-suite.js android",
		"test:ios": "node scripts/run-suite.js ios",
		"test:mobile": "node scripts/run-suite.js mobile",
		"test:smoke": "node scripts/run-suite.js smoke",
		"test:headed": "node scripts/run-suite.js web --headed",
		"test:ui": "node scripts/run-suite.js web --ui",
		"test:signup": "node scripts/run-suite.js signup",
		"test:debug": "node scripts/run-suite.js web --debug",
		"lint": "node scripts/syntax-check.js",
		"check:env": "node scripts/check-env.js",
		"report": "node scripts/report.js",
		"test:unit": "node scripts/unit-tests.js",
		"test:diagnostics:browser": "node --test tests-browser/diagnostics.cjs",
		"check:types": "tsc --noEmit",
		"lease:inspect": "node scripts/recover-lease.js"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "22.20.5",
		"dotenv": "^16.4.5",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	}
}
